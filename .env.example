# =============================================================
# .env.example — copy to .env và điền credentials thực tế
# =============================================================

# === Database ===
POSTGRES_PASSWORD=your_secure_password
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/affiliate_db

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === AI Models ===
GROQ_API_KEY=gsk_...         # primary, bắt buộc cho demo.py: https://console.groq.com/keys
GEMINI_API_KEY=...            # fallback: https://aistudio.google.com/apikey (free tier KHÔNG có quota tạo ảnh)
OPENAI_API_KEY=sk-...         # optional fallback
ELEVENLABS_API_KEY=...        # optional TTS
# GROQ_MODEL=qwen/qwen3.8-27b    # mặc định; openai/gpt-oss-120b hay sai chính tả tiếng Việt
# === Giọng đọc (demo.py) ===
# Mặc định "gemini" khi có GEMINI_API_KEY: giọng có cảm xúc. Free tier chỉ 10 lượt/ngày (4 lượt/video);
# hết lượt thì cả video tự chuyển sang edge-tts.
# TTS_PROVIDER=gemini             # gemini | edge
# Giọng tự chọn theo danh mục/tên sản phẩm: điện tử, máy móc, ô tô, thể thao/tập luyện → nam Hà Nội;
# sức khỏe, gia đình, mẹ bé, quà tặng, tình cảm và mọi thứ khác → nữ Sài Gòn. Đặt dòng dưới để ép 1 giọng cho mọi video.
# GEMINI_TTS_PERSONA=nu_nam       # nu_nam (nữ Sài Gòn) | nam_bac (nam Hà Nội)
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# TTS_VOICE=vi-VN-HoaiMyNeural   # giọng narrator khi dùng edge-tts; hoặc vi-VN-NamMinhNeural (giọng nam)

# === Ảnh nhân vật cho style=story (demo.py) ===
# Mặc định "manual": tự tạo ảnh trong Gemini app theo prompts.txt rồi chạy --rerender (miễn phí).
# IMAGE_PROVIDER=manual           # manual | gemini (cần bật billing Gemini API) | pollinations | none
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# === Duyệt video (demo.py) ===
# web (mặc định): làm xong video thì dừng ở status=review, duyệt và sửa trên trang Studio
#   http://127.0.0.1:8000/studio (bấm đúp scripts/mo-studio.command). terminal: hỏi y/n như cũ.
# APPROVAL_MODE=web               # web | terminal

# === TikTok OAuth2 ===
# Đăng ký tại: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...
TIKTOK_ACCESS_TOKEN=...       # Lấy sau khi chạy OAuth flow: GET /api/tiktok/auth/login
TIKTOK_REFRESH_TOKEN=...
# TIKTOK_REDIRECT_URI=https://chungkhoantony1983.github.io/tt-affiliate/app.html
# CREATOR_WEB_ORIGIN=https://chungkhoantony1983.github.io

# === Shopee Open Platform (tạm dừng, ưu tiên TikTok Shop) ===
# Đăng ký tại: https://open.shopee.com/
SHOPEE_ENABLED=false
SHOPEE_APP_ID=...             # Partner ID
SHOPEE_SECRET_KEY=...         # Partner Key
SHOPEE_AFFILIATE_UNIQUE_ID=...  # Affiliate unique ID cho tracking link

# === Lazada Open Platform (future) ===
LAZADA_APP_KEY=
LAZADA_APP_SECRET=

# === Google Sheets ===
# File service account đặt ở root repo (đã gitignore)
GOOGLE_APPLICATION_CREDENTIALS=google-credentials.json
SPREADSHEET_ID=...

# === Video bài tập (demo.py --exercise) ===
# Chỉ cần khi chạy --allow-stock (clip minh hoạ chung từ Pixabay): https://pixabay.com/api/docs/
PIXABAY_API_KEY=...
# EXERCISE_TTS_MODEL=gemini-3.1-flash-tts-preview   # hạn mức riêng, không giành lượt với video sản phẩm

# === Google Drive: nơi lưu video đã duyệt (demo.py) ===
# Mỗi sản phẩm 1 thư mục con. Tải lên xong thì xoá bản trên máy (giữ lại: --keep-local).
# Cần google-oauth-client.json (đăng nhập bằng tài khoản Google của bạn), xem đầu file drive_upload.py.
DRIVE_FOLDER_ID=...

# === Telegram Notifications ===
# Bot token từ @BotFather, chat_id từ @userinfobot
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# === N8N Admin ===
N8N_USER=admin
N8N_PASSWORD=your_secure_password
N8N_HOST=localhost

# === Storage Paths ===
STORAGE_PATH=./storage
VIDEO_OUTPUT_PATH=./storage/videos
PRODUCT_IMAGE_CACHE_PATH=./storage/images

# === Video Settings ===
MAX_VIDEO_DURATION=60
DEFAULT_LANGUAGE=vi
