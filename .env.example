# API Keys
# Groq (bắt buộc cho demo.py) — lấy miễn phí tại console.groq.com/keys
GROQ_API_KEY=gsk_...
# GROQ_MODEL=qwen/qwen3.8-27b    # mặc định; openai/gpt-oss-120b hay sai chính tả tiếng Việt
# TTS_VOICE=vi-VN-HoaiMyNeural   # giọng narrator; hoặc vi-VN-NamMinhNeural (giọng nam)

# Ảnh nhân vật cho style=story
# Mặc định "manual": tự tạo ảnh trong Gemini app theo prompts.txt rồi chạy --rerender (miễn phí).
# IMAGE_PROVIDER=manual           # manual | gemini (cần bật billing Gemini API) | pollinations | none
# GEMINI_API_KEY=...              # aistudio.google.com/apikey — free tier KHÔNG có quota tạo ảnh
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...

# TikTok App (đăng ký tại developers.tiktok.com)
TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...
TIKTOK_ACCESS_TOKEN=...

# Shopee Affiliate API
SHOPEE_APP_ID=...
SHOPEE_SECRET_KEY=...
SHOPEE_AFFILIATE_UNIQUE_ID=...

# Telegram Notifications
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# Database
POSTGRES_PASSWORD=your_secure_password

# N8N Admin
N8N_USER=admin
N8N_PASSWORD=your_secure_password
N8N_HOST=localhost

# Kling AI (video generation)
KLING_API_KEY=...

# App Settings
VIDEO_OUTPUT_PATH=./storage/videos
PRODUCT_IMAGE_CACHE_PATH=./storage/images
MAX_VIDEO_DURATION=60
DEFAULT_LANGUAGE=vi
